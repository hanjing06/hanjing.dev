# Copy to .env.local and fill in. All optional.

# Guest book storage in production (Upstash, or Vercel's KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The CD on the desk shows what you're listening to (README → "Spotify")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
